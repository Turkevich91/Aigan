TELEGRAM_BOT_TOKEN=put_telegram_bot_token_here
OPENAI_API_KEY=put_openai_api_key_here
BOT_USERNAME=
OPENAI_MODEL=gpt-5.4-mini
MODEL_REASONING_EFFORT=none
MODEL_VERBOSITY=low
MAX_OUTPUT_TOKENS=900
BOT_TRIGGER=!m
ALLOWED_CHAT_IDS=
ADMIN_USER_IDS=
USER_COOLDOWN_SECONDS=20
CHAT_COOLDOWN_SECONDS=5
MAX_INPUT_CHARS=2500
MAX_REPLY_CHARS=3600
MAX_HISTORY_MESSAGES=8
PASSIVE_CONTEXT_MESSAGES=40
YOUTUBE_AUDIO_FALLBACK=false
YOUTUBE_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
YOUTUBE_MAX_DURATION_SECONDS=1200
LOG_LEVEL=INFO
