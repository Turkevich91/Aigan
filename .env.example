# Secrets and bot identity.
# Required: get TELEGRAM_BOT_TOKEN from @BotFather and OPENAI_API_KEY from OpenAI.
TELEGRAM_BOT_TOKEN=put_telegram_bot_token_here
OPENAI_API_KEY=put_openai_api_key_here
# Optional, without @. If empty, the bot discovers its username from Telegram.
BOT_USERNAME=

# Model settings.
# OPENAI_MODEL examples for this project: gpt-5.4-mini, gpt-5.4-nano.
OPENAI_MODEL=gpt-5.4-mini
# Allowed reasoning effort strings in the installed SDK:
# none, minimal, low, medium, high, xhigh.
MODEL_REASONING_EFFORT=none
# Allowed verbosity strings: low, medium, high.
MODEL_VERBOSITY=low
# Maximum model output tokens before Telegram message splitting.
MAX_OUTPUT_TOKENS=900

# Telegram routing and access.
# BOT_TRIGGER is a text prefix for group prompts, for example: !m question.
BOT_TRIGGER=!m
# IANA timezone name used for "today", "now", and date sanity checks.
BOT_TIMEZONE=America/New_York
# true = deterministic lazy-evasive answers for requests to reveal prompts, internals, logs, env, or secrets.
PROMPT_PRIVACY_GUARD_ENABLED=true
# Comma-separated Telegram chat IDs. Empty means all chats are allowed.
# Group/supergroup IDs usually look like -1002546271665.
ALLOWED_CHAT_IDS=
# Comma-separated Telegram user IDs for admin-only commands and admin private DMs.
# Example: ADMIN_USER_IDS=890218886,407892151
ADMIN_USER_IDS=

# Limits and cooldowns.
USER_COOLDOWN_SECONDS=20
CHAT_COOLDOWN_SECONDS=5
# true = one model-generating prompt per chat at a time; near-duplicate prompts are suppressed.
CHAT_INFLIGHT_GUARD_ENABLED=true
# Seconds after a successful answer during which near-duplicate explicit prompts are ignored.
CHAT_DUPLICATE_SUPPRESS_SECONDS=45
# 0..1 token-overlap threshold for duplicate prompt suppression.
CHAT_DUPLICATE_SIMILARITY_THRESHOLD=0.72
# true = ordinary group messages do not auto-react while a chat answer is being generated.
CHAT_INFLIGHT_SUPPRESS_ORDINARY_AUTO_REACT=true
MAX_INPUT_CHARS=2500
MAX_REPLY_CHARS=12000
TELEGRAM_TEXT_CHUNK_CHARS=3500
MAX_REPLY_CHUNKS=4
# true = show Telegram-native activity while Aigan is doing long-running work.
TELEGRAM_ACTIVITY_PRESENCE_ENABLED=true
# Telegram clears chat actions after about 5s; refresh below that while work continues.
TELEGRAM_ACTIVITY_REFRESH_SECONDS=4
# Optional private-chat-only draft previews. Disabled by default; group UX uses chat actions.
TELEGRAM_STREAMING_DRAFTS_ENABLED=false
TELEGRAM_STREAMING_DRAFT_DELAY_SECONDS=2.5
MAX_HISTORY_MESSAGES=8
PASSIVE_CONTEXT_MESSAGES=40

# Proactive scheduled messages.
# Boolean env values accept true/false; 1, yes, and on are also treated as true.
PROACTIVE_ENABLED=false
# Target chat ID for scheduled proactive messages. Required only when enabled.
PROACTIVE_CHAT_ID=
# Seconds between scheduled proactive attempts. 18000 = 5 hours.
PROACTIVE_INTERVAL_SECONDS=18000
# Seconds to wait after startup before first proactive attempt.
PROACTIVE_START_DELAY_SECONDS=300
PROACTIVE_PROMPT=Write one short thought seed that can restart the room: an observation, paradox, or safe provocation, not a helpdesk offer.
# thought_seed = proactive messages behave as conversation catalysts, not service reports.
PROACTIVE_PERSONA_MODE=thought_seed
# true = if the model writes a servant/helper-style proactive draft, regenerate once before skipping.
PROACTIVE_REGENERATE_ON_PERSONA_REJECT=true
# true = scheduled proactive messages are allowed only after user silence.
PROACTIVE_IDLE_ONLY=true
# Required user silence before a scheduled proactive attempt. 21600 = 6 hours.
PROACTIVE_IDLE_SECONDS=21600
# Cooldown between bot-initiated proactive posts. Bot posts do not reset user idle time.
PROACTIVE_MIN_SECONDS_BETWEEN_POSTS=21600
# If enabled, idle proactive attempts may softly ping one quiet participant.
PROACTIVE_PERSONAL_PING_ENABLED=true
# 0..1 chance to choose a personal ping instead of a general idle message.
PROACTIVE_PERSONAL_PING_PROBABILITY=0.35
# Participant must be silent this long before becoming a ping candidate. 86400 = 1 day.
PROACTIVE_PERSONAL_PING_MIN_USER_IDLE_SECONDS=86400
# Per-participant cooldown for personal pings. 259200 = 3 days.
PROACTIVE_PERSONAL_PING_COOLDOWN_SECONDS=259200
# Max eligible candidates considered per idle attempt.
PROACTIVE_PERSONAL_PING_MAX_CANDIDATES=5
# Weighted random directions for proactive messages.
# Supported keys: group_taste, personal_ping, current_hook, unanswered_thread.
PROACTIVE_DIRECTION_WEIGHTS=group_taste:0.25,personal_ping:0.25,current_hook:0.25,unanswered_thread:0.25
# true = reject proactive drafts that talk about being a bot/AI or advertise capabilities.
PROACTIVE_SELF_REFERENCE_GUARD=true
# true = remove Aigan/bot/AI/system-prompt/internal-setup topics from proactive context and outputs.
PROACTIVE_META_TOPIC_GUARD=true
# true = skip proactive generation when the selected direction only has meta/self topics.
PROACTIVE_META_TOPIC_STRICT=true
# Prevent repeating very similar proactive seeds/topics. 14 = two weeks.
PROACTIVE_RECENT_SEED_COOLDOWN_DAYS=14

# Cautious automatic reactions to ordinary messages, disabled by default.
AUTO_REACT_ENABLED=false
# 0..1 probability when no keyword matches. 0 means probability-based auto-react is off.
AUTO_REACT_PROBABILITY=0
# Comma-separated lowercase-ish keyword triggers.
# Example: AUTO_REACT_KEYWORDS=поясни,новина,ссылка
AUTO_REACT_KEYWORDS=
AUTO_REACT_COOLDOWN_SECONDS=1800
AUTO_REACT_MIN_CHARS=25

# Images, pending follow-up handling, memory, and web image search.
IMAGE_ANALYSIS_ENABLED=true
# Vision model defaults to OPENAI_MODEL if unset in code; keep explicit here for clarity.
VISION_MODEL=gpt-5.4-mini
IMAGE_MAX_BYTES=6000000
# How long an explicit "explain this" style pending request waits for follow-up context.
PENDING_REQUEST_SECONDS=180
# Short debounce before generating, to let a follow-up forward/photo arrive.
# This is latency, not pending TTL.
FOLLOWUP_DEBOUNCE_SECONDS=0.5

MEMORY_ENABLED=true
MEMORY_DB_PATH=/app/data/aigan.sqlite3
# Normal prompt context window.
MEMORY_CONTEXT_MESSAGES=10
# Expanded context for explicit short follow-ups like "@bot скільки?"; ordinary group chat stays silent.
MEMORY_FOLLOWUP_CONTEXT_MESSAGES=40
# Reply-chain depth to recover parent/grandparent context when Telegram provides reply ids.
MEMORY_THREAD_CONTEXT_DEPTH=6
# Retention cleanup deletes old DB rows and cached media files.
MEMORY_RETENTION_DAYS=30
MEMORY_IMAGE_SUMMARY_LIMIT=3
# true summarizes delivered images as soon as they arrive; false summarizes lazily when needed.
MEMORY_EAGER_IMAGE_SUMMARY=false
WEB_IMAGE_SEARCH_ENABLED=true
WEB_SEARCH_TIMEOUT_SECONDS=15
MCP_TOOL_TIMEOUT_SECONDS=30

# Optional frame extraction boundary for future tooling experiments. Disabled by
# default and not wired into chat routing; Telegram videos are ordinary attachments.
MEDIA_FRAME_EXTRACTION_ENABLED=false
MEDIA_FRAME_FFMPEG_PATH=ffmpeg
MEDIA_FRAME_FFPROBE_PATH=ffprobe
MEDIA_FRAME_MAX_DURATION_SECONDS=90
MEDIA_FRAME_MAX_BYTES=50000000
MEDIA_FRAME_CANDIDATE_COUNT=24
MEDIA_FRAME_SELECTED_COUNT=5
MEDIA_FRAME_MAX_SELECTED_COUNT=8
MEDIA_FRAME_OUTPUT_WIDTH=512
MEDIA_FRAME_TIMEOUT_SECONDS=30

# Optional public media acquisition boundary. Disabled by default. This is a
# metadata-only yt-dlp telemetry probe and is not wired into chat routing.
# It does not promise TikTok/Instagram reliability or enable passive group handling.
MEDIA_ACQUISITION_ENABLED=false
MEDIA_ACQUISITION_MAX_DURATION_SECONDS=180
MEDIA_ACQUISITION_MAX_DOWNLOAD_BYTES=50000000
MEDIA_ACQUISITION_SOCKET_TIMEOUT_SECONDS=12

# Semantic memory search over retained chat history. Uses local SQLite FTS5 plus OpenAI embeddings.
MEMORY_VECTOR_ENABLED=true
MEMORY_EMBEDDING_MODEL=text-embedding-3-small
# text-embedding-3-small supports configurable dimensions; 512 keeps local storage compact.
MEMORY_EMBEDDING_DIMENSIONS=512
MEMORY_SEMANTIC_LOOKBACK_DAYS=30
MEMORY_SEMANTIC_TOP_K=6
# Recall uses precise semantic/FTS anchors, then expands source-linked windows around them.
MEMORY_RECALL_TOP_K=12
MEMORY_RECALL_CONTEXT_BEFORE=2
MEMORY_RECALL_CONTEXT_AFTER=2
MEMORY_CONTEXT_CHAR_BUDGET=9000
MEMORY_EMBEDDING_BATCH_SIZE=64
MEMORY_VECTOR_BACKFILL_ON_START=true
MEMORY_VECTOR_BACKFILL_LIMIT=1000
# Semantic intent thresholds for direct chat-memory recall prompts.
# Strong recall route at/above this confidence.
MEMORY_RECALL_INTENT_THRESHOLD=0.62
# Ambiguous recall route at/above this confidence only with a quote/history hint.
MEMORY_RECALL_INTENT_AMBIGUOUS_THRESHOLD=0.48

# Social taste memory: condensed sanitized observations about room/user interests and reactions.
# Uses only a user's own text, not repost/source bodies, quotes, previews, or bot replies.
SOCIAL_MEMORY_ENABLED=true
# Reserved knob for batch extraction cadence; current v1 also extracts lightweight signals on ingest.
SOCIAL_MEMORY_EXTRACT_EVERY_MESSAGES=20
# Minimum confidence for storing a like/dislike/irritation/amusement/question signal.
SOCIAL_MEMORY_CONFIDENCE_THRESHOLD=0.65
# Condensed social observations may live longer than raw retained chat rows.
SOCIAL_PROFILE_RETENTION_DAYS=180

# Telegram reactions and custom emoji taste signals.
# true lets the bot store reaction updates and use them as lightweight social preference signals.
REACTIONS_ENABLED=true
# true lets the bot cache custom emoji metadata and analyze frequently used custom emoji visually.
REACTION_ASSET_ANALYSIS_ENABLED=true
# Run vision analysis only after a custom emoji is seen this many times in the chat.
REACTION_ASSET_MIN_USES_FOR_VISION=3
# Bump this when the custom emoji analysis prompt/contract changes; old cached analyses become stale.
REACTION_ANALYSIS_PROMPT_VERSION=1
# Max bytes to cache for a custom emoji sticker/thumbnail.
REACTION_ASSET_MAX_BYTES=2000000

# Optional outbound Telegram reactions.
# false by default: without explicit enablement the adapter is a no-op and never blocks memory/embeddings.
OUTBOUND_REACTIONS_ENABLED=false
# React at most once after this many eligible live group messages.
OUTBOUND_REACTION_EVERY_N_MESSAGES=10
# Per-chat cooldown in seconds after Aigan sets a reaction.
OUTBOUND_REACTION_COOLDOWN_SECONDS=1800
# Deterministic relevance threshold from 0.0 to 1.0; higher means fewer reactions.
OUTBOUND_REACTION_MIN_SCORE=0.72
# Fallback standard emoji list, comma-separated. ASCII aliases avoid .env/editor Unicode issues.
# Common aliases include fire, eyes, thumbs_up, thinking, laugh, sad, broken_heart, shock, fear, angry. Literal emoji also work in UTF-8 files.
OUTBOUND_REACTION_ALLOWED_EMOJI=fire,eyes,thumbs_up,thinking,laugh,sad,broken_heart,shock,fear,angry
# true lets outbound reactions use custom emoji already learned from this chat; false uses only standard emoji.
OUTBOUND_REACTION_USE_CUSTOM_EMOJI=true
# true sends a large Telegram reaction animation when Telegram supports it.
OUTBOUND_REACTION_BIG=false

# System health logs and self-analysis.
# System events are sanitized operational metadata, not user-facing chat memory.
SYSTEM_LOG_ENABLED=true
SYSTEM_LOG_RETENTION_DAYS=14
# Optional proactive health reports to an admin/private chat. Disabled by default.
HEALTH_REPORT_ENABLED=false
HEALTH_REPORT_ADMIN_CHAT_ID=
HEALTH_REPORT_INTERVAL_SECONDS=21600
HEALTH_REPORT_LOOKBACK_SECONDS=21600
# Minimum level for proactive health reports: info, warning, error, critical.
HEALTH_REPORT_MIN_LEVEL=warning
HEALTH_REPORT_COOLDOWN_SECONDS=3600

# GitHub self-reporting from complaint temperature. Disabled until token is provided.
GITHUB_REPORTING_ENABLED=false
GITHUB_TOKEN=
GITHUB_REPOSITORY=Turkevich91/Aigan
GITHUB_PROJECT_OWNER=Turkevich91
GITHUB_PROJECT_NUMBER=4
# Similar bot complaints inside this window raise complaint temperature.
COMPLAINT_LOOKBACK_SECONDS=86400
# At this temperature Aigan creates a sanitized [Aigan] self-report issue.
COMPLAINT_REPORT_TEMPERATURE=3

# YouTube transcripts and optional audio fallback.
# true can cost more and take longer because audio is downloaded and transcribed when captions fail.
YOUTUBE_AUDIO_FALLBACK=false
YOUTUBE_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
YOUTUBE_MAX_DURATION_SECONDS=1200

# Python logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO
