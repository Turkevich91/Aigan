# Secrets and bot identity.
# Required: get TELEGRAM_BOT_TOKEN from @BotFather and OPENAI_API_KEY from OpenAI.
TELEGRAM_BOT_TOKEN=put_telegram_bot_token_here
OPENAI_API_KEY=put_openai_api_key_here
# Optional, without @. If empty, the bot discovers its username from Telegram.
BOT_USERNAME=

# Model settings.
# OPENAI_MODEL examples for this project: gpt-5.4-mini, gpt-5.4-nano.
OPENAI_MODEL=gpt-5.4-mini
# Allowed reasoning effort strings in the installed SDK:
# none, minimal, low, medium, high, xhigh.
MODEL_REASONING_EFFORT=none
# Allowed verbosity strings: low, medium, high.
MODEL_VERBOSITY=low
# Maximum model output tokens before Telegram message splitting.
MAX_OUTPUT_TOKENS=900

# Telegram routing and access.
# BOT_TRIGGER is a text prefix for group prompts, for example: !m question.
BOT_TRIGGER=!m
# IANA timezone name used for "today", "now", and date sanity checks.
BOT_TIMEZONE=America/New_York
# Comma-separated Telegram chat IDs. Empty means all chats are allowed.
# Group/supergroup IDs usually look like -1002546271665.
ALLOWED_CHAT_IDS=
# Comma-separated Telegram user IDs for admin-only commands and admin private DMs.
# Example: ADMIN_USER_IDS=890218886,407892151
ADMIN_USER_IDS=

# Limits and cooldowns.
USER_COOLDOWN_SECONDS=20
CHAT_COOLDOWN_SECONDS=5
MAX_INPUT_CHARS=2500
MAX_REPLY_CHARS=12000
TELEGRAM_TEXT_CHUNK_CHARS=3500
MAX_REPLY_CHUNKS=4
MAX_HISTORY_MESSAGES=8
PASSIVE_CONTEXT_MESSAGES=40

# Proactive scheduled messages.
# Boolean env values accept true/false; 1, yes, and on are also treated as true.
PROACTIVE_ENABLED=false
# Target chat ID for scheduled proactive messages. Required only when enabled.
PROACTIVE_CHAT_ID=
# Seconds between scheduled proactive attempts. 18000 = 5 hours.
PROACTIVE_INTERVAL_SECONDS=18000
# Seconds to wait after startup before first proactive attempt.
PROACTIVE_START_DELAY_SECONDS=300
PROACTIVE_PROMPT=Write a brief, useful group check-in. Be professional, concise, and only lightly ironic if the context invites it.

# Cautious automatic reactions to ordinary messages, disabled by default.
AUTO_REACT_ENABLED=false
# 0..1 probability when no keyword matches. 0 means probability-based auto-react is off.
AUTO_REACT_PROBABILITY=0
# Comma-separated lowercase-ish keyword triggers.
# Example: AUTO_REACT_KEYWORDS=поясни,новина,ссылка
AUTO_REACT_KEYWORDS=
AUTO_REACT_COOLDOWN_SECONDS=1800
AUTO_REACT_MIN_CHARS=25

# Images, pending follow-up handling, memory, and web image search.
IMAGE_ANALYSIS_ENABLED=true
# Vision model defaults to OPENAI_MODEL if unset in code; keep explicit here for clarity.
VISION_MODEL=gpt-5.4-mini
IMAGE_MAX_BYTES=6000000
# How long an explicit "explain this" style pending request waits for follow-up context.
PENDING_REQUEST_SECONDS=180
# Short debounce before generating, to let a follow-up forward/photo arrive.
# This is latency, not pending TTL.
FOLLOWUP_DEBOUNCE_SECONDS=0.5

MEMORY_ENABLED=true
MEMORY_DB_PATH=/app/data/aigan.sqlite3
# Normal prompt context window.
MEMORY_CONTEXT_MESSAGES=10
# Expanded context for explicit short follow-ups like "@bot скільки?"; ordinary group chat stays silent.
MEMORY_FOLLOWUP_CONTEXT_MESSAGES=40
# Reply-chain depth to recover parent/grandparent context when Telegram provides reply ids.
MEMORY_THREAD_CONTEXT_DEPTH=6
# Retention cleanup deletes old DB rows and cached media files.
MEMORY_RETENTION_DAYS=30
MEMORY_IMAGE_SUMMARY_LIMIT=3
# true summarizes delivered images as soon as they arrive; false summarizes lazily when needed.
MEMORY_EAGER_IMAGE_SUMMARY=false
WEB_IMAGE_SEARCH_ENABLED=true

# Semantic memory search over retained chat history. Uses local SQLite FTS5 plus OpenAI embeddings.
MEMORY_VECTOR_ENABLED=true
MEMORY_EMBEDDING_MODEL=text-embedding-3-small
# text-embedding-3-small supports configurable dimensions; 512 keeps local storage compact.
MEMORY_EMBEDDING_DIMENSIONS=512
MEMORY_SEMANTIC_LOOKBACK_DAYS=30
MEMORY_SEMANTIC_TOP_K=6
MEMORY_EMBEDDING_BATCH_SIZE=64
MEMORY_VECTOR_BACKFILL_ON_START=true
MEMORY_VECTOR_BACKFILL_LIMIT=1000

# System health logs and self-analysis.
# System events are sanitized operational metadata, not user-facing chat memory.
SYSTEM_LOG_ENABLED=true
SYSTEM_LOG_RETENTION_DAYS=14
# Optional proactive health reports to an admin/private chat. Disabled by default.
HEALTH_REPORT_ENABLED=false
HEALTH_REPORT_ADMIN_CHAT_ID=
HEALTH_REPORT_INTERVAL_SECONDS=21600
HEALTH_REPORT_LOOKBACK_SECONDS=21600
# Minimum level for proactive health reports: info, warning, error, critical.
HEALTH_REPORT_MIN_LEVEL=warning
HEALTH_REPORT_COOLDOWN_SECONDS=3600

# GitHub self-reporting from complaint temperature. Disabled until token is provided.
GITHUB_REPORTING_ENABLED=false
GITHUB_TOKEN=
GITHUB_REPOSITORY=Turkevich91/Aigan
GITHUB_PROJECT_OWNER=Turkevich91
GITHUB_PROJECT_NUMBER=4
# Similar bot complaints inside this window raise complaint temperature.
COMPLAINT_LOOKBACK_SECONDS=86400
# At this temperature Aigan creates a sanitized [Aigan] self-report issue.
COMPLAINT_REPORT_TEMPERATURE=3

# YouTube transcripts and optional audio fallback.
# true can cost more and take longer because audio is downloaded and transcribed when captions fail.
YOUTUBE_AUDIO_FALLBACK=false
YOUTUBE_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
YOUTUBE_MAX_DURATION_SECONDS=1200

# Python logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO
